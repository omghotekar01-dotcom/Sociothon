# Local synthetic demonstration. Never use demo mode for a public deployment.
CIVIC_DEMO_MODE=true
DATABASE_URL=sqlite:///./data/civicsignal.db
# See services/api/database.py and security.py for enforced configuration.
# PostgreSQL Docker example:
# DATABASE_URL=postgresql+psycopg://civic:civic-local@db:5432/civic

# OPTIONAL — Gemini Investigation Desk (disabled until you set a key).
# Copy .env.example to .env and replace the placeholder locally.
# NEVER paste an API key into GitHub, commits, screenshots, or frontend code.
# A report is sent to Gemini only when an authorized staff member clicks Analyze.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
